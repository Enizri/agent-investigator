PINECONE_API_KEY=
PINECONE_INDEX=security-investigator
PINECONE_NAMESPACE=security-v1
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Local Ollama model. Used for a new incoming record and for the final answer.
# The seeded index uses the summaries already written with the company.
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_SUMMARIZER_ENABLED=true
LOCAL_SUMMARIZER_MODEL=qwen3:8b

# Optional remote model. Used instead of the local summarizer only when both are set.
# Leave LLM_BASE_URL empty to use the OpenAI API.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

DATABASE_PATH=data/security.db

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
# original embeds the chunk. summary embeds the short summary.
# contextual embeds the summary and then the original chunk.
EMBED_MODE=contextual
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANK_ENABLED=true

TOP_K_DENSE=20
TOP_K_BM25=20
TOP_K_RERANK=6
MAX_AGENT_STEPS=6
MAX_RETRIEVAL_ATTEMPTS=2
RRF_K=60

REFERENCE_TIME=2026-10-11T00:00:00Z
RANDOM_SEED=42
LOG_LEVEL=INFO
